@{
    ViewData["Title"] = "avaliação 4two";
    var notaAtual = ViewData["Nota"] as string ?? string.Empty;
    var notas = C4Two.Services.CodigoLiberacaoStore.NotasAvaliacao;
    string Cor(string nota) => nota switch
    {
        "Ruim" => "#B42318",
        "Insatisfeito" => "#D97706",
        "Regular" => "#8A8478",
        "Satisfeito" => "#06793A",
        _ => "#056832"
    };
    string Boca(string nota) => nota switch
    {
        "Ruim" => "M8 17c1.2-2.2 2.6-3.2 4-3.2s2.8 1 4 3.2",
        "Insatisfeito" => "M8 16.2c1.2-1.2 2.6-1.8 4-1.8s2.8.6 4 1.8",
        "Regular" => "M8 15h8",
        "Satisfeito" => "M8 14c1.2 1.6 2.6 2.4 4 2.4s2.8-.8 4-2.4",
        _ => "M7 13c1.5 2.6 3.1 3.8 5 3.8s3.5-1.2 5-3.8"
    };
}

<section class="space-y-6 py-10" style="display:flex;flex-direction:column;align-items:center">
    <img class="h-36 w-36 rounded-3xl object-cover shadow-lg" src="~/src/img/4two.jpg" alt="Logotipo 4two" />
    <h1 class="text-4xl font-extrabold tracking-tight text-gray-900">avaliação 4two</h1>
    <p class="text-lg text-gray-600">Como foi o atendimento?</p>
    <div role="group" aria-label="Avaliação do serviço" style="display:flex;flex-wrap:wrap;justify-content:center;gap:1rem">
        @foreach (var nota in notas)
        {
            var escolhida = string.Equals(notaAtual, nota, StringComparison.Ordinal);
            <button type="button" class="nota-avaliacao" data-nota="@nota" aria-label="@nota" aria-pressed="@(escolhida ? "true" : "false")" @(string.IsNullOrEmpty(notaAtual) ? null : "disabled") style="display:flex;flex-direction:column;align-items:center;gap:0.5rem;background:transparent;border:0;cursor:pointer;padding:0.25rem;border-radius:999px;@(escolhida ? "outline:3px solid #06793A;" : "")">
                <svg viewBox="0 0 24 24" width="56" height="56" aria-hidden="true" style="width:3.5rem;height:3.5rem">
                    <circle cx="12" cy="12" r="10" fill="@Cor(nota)"></circle>
                    <circle cx="9" cy="10" r="1.1" fill="#fff"></circle>
                    <circle cx="15" cy="10" r="1.1" fill="#fff"></circle>
                    <path d="@Boca(nota)" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round"></path>
                </svg>
                <span class="text-sm font-semibold text-gray-900">@nota</span>
            </button>
        }
    </div>
</section>

<form id="form-avaliacao" method="post" style="display:none">
    @Html.AntiForgeryToken()
</form>

<div id="modal-avaliacao" role="presentation" style="display:@(string.IsNullOrEmpty(notaAtual) ? "none" : "flex");position:fixed;inset:0;z-index:50;align-items:center;justify-content:center;background:rgba(0,0,0,.45);padding:1rem">
    <div class="space-y-6 rounded-2xl bg-white px-6 py-5 shadow" role="dialog" aria-modal="true" aria-labelledby="avaliacao-titulo" style="width:100%;max-width:32rem">
        <p id="avaliacao-titulo" class="text-2xl font-extrabold tracking-tight text-gray-900">Obrigado pela sua avaliação</p>
        <p class="text-lg text-gray-700">A sessão atual será encerrada.</p>
        <button type="button" id="encerrar-sessao" class="rounded-2xl bg-[#06793A] px-8 py-4 text-lg font-semibold text-white shadow-lg transition hover:bg-[#056832]">Encerrar sessão</button>
    </div>
</div>

<script>
    var formulario = document.getElementById("form-avaliacao");
    var tokenCampo = formulario ? formulario.querySelector("input[name='__RequestVerificationToken']") : null;
    var token = tokenCampo ? tokenCampo.value : "";
    document.querySelectorAll(".nota-avaliacao").forEach(function (botao) {
        botao.addEventListener("click", function () {
            if (botao.disabled) {
                return;
            }
            var corpo = new URLSearchParams();
            corpo.set("nota", botao.getAttribute("data-nota") || "");
            fetch("/avaliacao", {
                method: "POST",
                credentials: "same-origin",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "RequestVerificationToken": token
                },
                body: corpo.toString()
            }).then(function (resposta) {
                return resposta.json();
            }).then(function (dados) {
                if (!dados || !dados.ok) {
                    return;
                }
                document.querySelectorAll(".nota-avaliacao").forEach(function (item) {
                    item.disabled = true;
                    item.setAttribute("aria-pressed", item === botao ? "true" : "false");
                    item.style.outline = item === botao ? "3px solid #06793A" : "";
                });
                var modal = document.getElementById("modal-avaliacao");
                if (modal) {
                    modal.style.display = "flex";
                }
            });
        });
    });

    var encerrar = document.getElementById("encerrar-sessao");
    if (encerrar) {
        encerrar.addEventListener("click", function () {
            encerrar.disabled = true;
            fetch("/avaliacao/encerrar", {
                method: "POST",
                credentials: "same-origin",
                headers: { "RequestVerificationToken": token }
            }).then(function (resposta) {
                return resposta.json();
            }).then(function (dados) {
                window.location.assign(dados && dados.destino ? dados.destino : "/cliente");
            }).catch(function () {
                encerrar.disabled = false;
            });
        });
    }
</script>
