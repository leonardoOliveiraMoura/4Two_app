<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - C4Two</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="bg-white shadow">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4">
            <div style="display:flex;flex-direction:column;align-items:flex-start">
                <a class="text-xl font-semibold" asp-controller="Main" asp-action="Index">4Two</a>
                <span class="text-sm text-gray-500">dividido, do jeito certo</span>
            </div>
            <nav class="flex flex-wrap gap-4">
                <!--<a class="hover:text-blue-600" asp-controller="Main" asp-action="Index">Main</a>
                <a class="hover:text-blue-600" asp-controller="Gerenciamento" asp-action="Index">Gerenciamento</a>
                <a class="hover:text-blue-600" asp-controller="Cliente" asp-action="Index">Cliente</a>
                <a class="hover:text-blue-600" asp-controller="LoginGerenciamento" asp-action="Index">Login Gerenciamento</a>
                <a class="hover:text-blue-600" asp-controller="LoginClientes" asp-action="Index">Login Clientes</a>-->
            </nav>
        </div>
    </header>
    <main class="mx-auto max-w-7xl px-4 py-6">
        @RenderBody()
    </main>
    <footer class="border-t bg-white">
        <div class="mx-auto max-w-7xl px-4 py-6 text-sm text-gray-600">
            &copy; @DateTime.Now.Year - C4Two
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
