@model LoginViewModel

<form asp-action="Index" method="post" class="max-w-md space-y-5">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="space-y-2">
        <label asp-for="Login" class="block text-sm font-semibold"></label>
        <input asp-for="Login" autocomplete="username" class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-gray-700 shadow-sm focus:border-[#06793A] focus:outline-none focus:ring-2 focus:ring-[#06793A]" />
        <span asp-validation-for="Login"></span>
    </div>

    <div class="space-y-2">
        <label asp-for="Senha" class="block text-sm font-semibold"></label>
        <input asp-for="Senha" autocomplete="current-password" class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-gray-700 shadow-sm focus:border-[#06793A] focus:outline-none focus:ring-2 focus:ring-[#06793A]" />
        <span asp-validation-for="Senha"></span>
    </div>

    <button type="submit" class="@ViewData["SubmitClass"]">Entrar</button>
</form>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />
